<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules file for Google Play Store compliance.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include app preferences -->
        <include domain="sharedpref" path="."/>
        
        <!-- Exclude AdMob and temporary data -->
        <exclude domain="sharedpref" path="com.google.android.gms.ads.xml"/>
        <exclude domain="cache" path="."/>
    </cloud-backup>
    
    <device-transfer>
        <!-- Include app preferences for device transfer -->
        <include domain="sharedpref" path="."/>
        
        <!-- Exclude AdMob cache -->
        <exclude domain="sharedpref" path="com.google.android.gms.ads.xml"/>
        <exclude domain="cache" path="."/>
    </device-transfer>
</data-extraction-rules>